# ==========================================
# SOC PLATFORM - ENVIRONMENT CONFIGURATION
# ==========================================
# Instructions:
# 1. Get your free Google Gemini API key from: https://aistudio.google.com/app/apikey
# 2. Get your free AbuseIPDB API key from: https://www.abuseipdb.com/
# 3. Paste them below (do NOT use quotes).
# 4. Save this file as .env and restart the backend.

GEMINI_API_KEY=your_gemini_api_key_here
ABUSEIPDB_API_KEY=your_abuseipdb_api_key_here
